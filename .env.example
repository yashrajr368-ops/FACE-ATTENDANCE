# Application Secret Key
SECRET_KEY=change-this-to-a-very-secure-random-string

# Database
DATABASE_URL=sqlite:///instance/attendance.db

# Camera Settings
CAMERA_INDEX=0

# Face Recognition Settings
# FACE_BACKEND options: auto, opencv, face_recognition
FACE_BACKEND=auto
FACE_MATCH_TOLERANCE=0.48
RECOGNITION_COOLDOWN_SECONDS=15

# Default Admin Credentials (created on first launch if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
